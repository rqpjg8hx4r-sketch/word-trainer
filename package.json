{
  "name": "word-trainer",
  "version": "2.29.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-site.js",
    "audio:words": "node scripts/generate-word-audio.js",
    "audio:missing": "node scripts/generate-word-audio.js --all-missing",
    "audio:speaking": "node scripts/generate-speaking-audio.js",
    "audio:speaking-missing": "node scripts/generate-speaking-audio.js --all-missing",
    "audio:paraphrase": "node scripts/generate-paraphrase-audio.js",
    "audio:paraphrase-missing": "node scripts/generate-paraphrase-audio.js --all-missing",
    "test": "node --test tests/content.test.js && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
